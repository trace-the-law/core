{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trace-the-law.invalid/v1/derivation.schema.json",
  "title": "Trace the Law derivation",
  "description": "One append-only transformation run from ordered, named input artifacts to one output artifact. Multiple runs or input routes may produce the same content-addressed output without overwriting provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "derivation_id",
    "output_artifact_id",
    "input_artifacts",
    "representation",
    "tool",
    "settings_digest",
    "reproducible",
    "rights_basis_capture_ids",
    "publication_clearance",
    "created_at"
  ],
  "properties": {
    "schema_id": {
      "const": "https://schemas.trace-the-law.invalid/v1/derivation.schema.json"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "derivation_id": {
      "$ref": "common.schema.json#/$defs/DerivationId"
    },
    "output_artifact_id": {
      "$ref": "common.schema.json#/$defs/ArtifactId"
    },
    "input_artifacts": {
      "description": "Array order is significant. Roles name distinct inputs without assuming a single-source transformation.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DerivationInput" }
    },
    "representation": {
      "enum": [
        "markdown_transcription",
        "extracted_text",
        "ocr_text",
        "translation",
        "summary",
        "structured_extraction",
        "thumbnail",
        "other"
      ]
    },
    "language": {
      "$ref": "common.schema.json#/$defs/LanguageTag"
    },
    "tool": {
      "$ref": "#/$defs/Tool"
    },
    "settings_digest": {
      "$ref": "common.schema.json#/$defs/ContentDigest"
    },
    "settings_artifact_id": {
      "$ref": "common.schema.json#/$defs/ArtifactId"
    },
    "reproducible": {
      "type": "boolean"
    },
    "rights_basis_capture_ids": {
      "description": "Source-scoped capture assessments that must be checked before this output is published. Listing a capture is evidence provenance, not permission by itself.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/CaptureId" }
    },
    "publication_clearance": {
      "description": "Output-specific privacy and sensitive-material review. Source capture clearances must also pass before publication.",
      "$ref": "common.schema.json#/$defs/PublicationClearance"
    },
    "quality": {
      "$ref": "artifact.schema.json#/$defs/Quality"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "representation": { "enum": ["translation", "summary"] }
        },
        "required": ["representation"]
      },
      "then": { "required": ["language"] }
    },
    {
      "if": {
        "properties": { "reproducible": { "const": true } },
        "required": ["reproducible"]
      },
      "then": { "required": ["settings_artifact_id"] }
    }
  ],
  "$defs": {
    "DerivationInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact_id"],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,63}$"
        },
        "artifact_id": {
          "$ref": "common.schema.json#/$defs/ArtifactId"
        }
      }
    },
    "Tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "code_url": {
          "$ref": "common.schema.json#/$defs/PublicUrl"
        },
        "method": {
          "type": "string",
          "maxLength": 240
        }
      }
    }
  }
}
